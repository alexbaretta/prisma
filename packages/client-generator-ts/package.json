{
  "name": "@prisma-lossless/client-generator-ts",
  "version": "7.8.0-lossless.14",
  "description": "This package is intended for Prisma's internal use",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/prisma/prisma.git",
    "directory": "packages/client-generator-ts"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@antfu/ni": "0.21.12",
    "@prisma-lossless/client-common": "7.8.0-lossless.14",
    "@prisma-lossless/debug": "7.8.0-lossless.14",
    "@prisma-lossless/dmmf": "7.8.0-lossless.14",
    "@prisma/engines-version": "7.8.0-6.3c6e192761c0362d496ed980de936e2f3cebcd3a",
    "@prisma-lossless/fetch-engine": "7.8.0-lossless.14",
    "@prisma-lossless/generator": "7.8.0-lossless.14",
    "@prisma-lossless/get-platform": "7.8.0-lossless.14",
    "@prisma-lossless/internals": "7.8.0-lossless.14",
    "@prisma-lossless/param-graph-builder": "7.8.0-lossless.14",
    "@prisma-lossless/ts-builders": "7.8.0-lossless.14",
    "fast-glob": "3.3.3",
    "get-tsconfig": "4.10.0",
    "indent-string": "4.0.0",
    "klona": "2.0.6",
    "package-up": "5.0.0",
    "pluralize": "8.0.0",
    "ts-pattern": "5.6.2"
  },
  "devDependencies": {
    "@types/pluralize": "0.0.33"
  },
  "scripts": {
    "dev": "DEV=true tsx helpers/build.ts",
    "build": "tsx helpers/build.ts",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run --testTimeout 30000"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false
}
