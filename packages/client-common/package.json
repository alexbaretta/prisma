      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/prisma/prisma.git",
    "directory": "packages/client-common"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@prisma-lossless/client-engine-runtime": "7.8.0-lossless.16",
    "@prisma-lossless/dmmf": "7.8.0-lossless.16",
    "@prisma-lossless/driver-adapter-utils": "7.8.0-lossless.16",
    "@prisma-lossless/generator": "7.8.0-lossless.16",
    "@prisma-lossless/internals": "7.8.0-lossless.16",
    "@prisma-lossless/param-graph": "7.8.0-lossless.16"
  },
  "scripts": {
    "dev": "DEV=true tsx helpers/build.ts",
    "build": "tsx helpers/build.ts",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run"
  },
  "files": [
    "dist"
  ],
