{
  "name": "@prisma-lossless/client-common",
  "version": "7.8.0-lossless.16",
  "description": "This package is intended for Prisma's internal use",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
